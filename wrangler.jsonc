{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default environment (no --env flag / CLOUDFLARE_ENV unset): the "personal" build. Deployed
  // as the Worker named "mnmapping" — this keeps the existing production URL. See
  // docs/two-versions.md for the full personal-vs-public deployment setup, including the
  // build-time NEXT_PUBLIC_APP_MODE and CLOUDFLARE_ENV variables each Cloudflare app must set.
  "name": "mnmapping",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // The "public" (sharing) environment. Wrangler environments don't inherit top-level fields,
  // so everything except `name` is repeated here on purpose.
  "env": {
    "public": {
      "name": "publicmnmapping",
      "compatibility_date": "2026-09-14",
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "main": "vinext/server/fetch-handler",
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "none",
        "binding": "ASSETS"
      },
      "cache": {
        "enabled": true
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}
