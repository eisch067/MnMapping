{
  "name": "mn-mapping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "screenshot": "node scripts/screenshot.mjs",
    "copy-cesium-assets": "node scripts/copy-cesium-assets.mjs",
    "generate-licensing-docs": "node scripts/generate-licensing-docs.mjs",
    "predev": "npm run copy-cesium-assets && npm run generate-licensing-docs",
    "dev": "next dev",
    "prebuild": "npm run copy-cesium-assets && npm run generate-licensing-docs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:registry": "node scripts/registry-audit.mjs",
    "test": "node scripts/test.mjs && npm run audit:registry",
    "smoke:remote:north": "node scripts/remote-source-smoke.mjs",
    "predev:vinext": "npm run copy-cesium-assets && npm run generate-licensing-docs",
    "dev:vinext": "vinext dev --port 3001",
    "prebuild:vinext": "npm run copy-cesium-assets && npm run generate-licensing-docs",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:vinext:public": "vinext-cloudflare deploy --config dist/server/wrangler.json --env public"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "cesium": "^1.132.0",
    "next": "^16.3.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.2"
  },
  "type": "module"
}
